{
  "title": "Hanwha \u2013 Raw MQTT messages",
  "uid": "hanwha-raw",
  "schemaVersion": 39,
  "refresh": "30s",
  "tags": [
    "hanwha"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Messages received",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "camdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "camdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"Messages\" FROM mqtt_messages WHERE $__timeFilter(received_at)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last message",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "camdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "camdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT max(received_at) AS \"Last\" FROM mqtt_messages"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Last$/"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Messages over time by topic type",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "camdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "camdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(received_at, $__interval), event AS metric, count(*) AS value\nFROM mqtt_messages WHERE $__timeFilter(received_at)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "interval": "5m"
    },
    {
      "id": 4,
      "type": "table",
      "title": "Latest raw messages",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "camdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "camdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT received_at AS time, camera, event, topic, payload\nFROM mqtt_messages WHERE $__timeFilter(received_at)\nORDER BY received_at DESC LIMIT 200"
        }
      ]
    }
  ],
  "links": [
    {
      "title": "Hanwha dashboards",
      "type": "dashboards",
      "tags": [
        "hanwha"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    }
  ]
}