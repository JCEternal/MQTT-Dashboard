# Template only - install.sh creates the real .env for you.
# To configure by hand instead:  cp .env.example .env  &&  nano .env

# "broker" = run the built-in Mosquitto broker. Leave empty to use an existing broker.
COMPOSE_PROFILES=broker
# "mosquitto" for built-in broker, otherwise your broker's IP
MQTT_HOST=mosquitto
# port the ingest service uses to reach the broker
MQTT_PORT=1883
# port cameras connect to (built-in broker only)
BROKER_PUBLIC_PORT=1883
# blank = no login required
MQTT_USER=hanwha
MQTT_PASS=ChangeMe-MQTT-Password

MQTT_TOPICS=+/onvif-ej/#
# e.g. E4:30:22:C5:6F:14=Lobby,E4:30:22:AA:BB:CC=Dock
CAMERA_NAMES=

POSTGRES_DB=camdata
POSTGRES_USER=camdata
POSTGRES_PASSWORD=ChangeMe-DB-Password

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMe-Grafana-Password

TZ=America/Detroit
